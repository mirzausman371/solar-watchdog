# ---- REQUIRED ----
# Long-lived signed querySPDeviceLastData URL.
# Get it: dessmonitor.com → login (SmartESS creds) → DevTools → Network →
# filter "querySPDeviceLastData" → right-click request → Copy URL.
DESS_URL=

# ---- ALERT CHANNELS (set at least one) ----
# Telegram: create bot via @BotFather, get chat id via @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# WAHA (self-hosted WhatsApp): chat id looks like 923001234567@c.us
WAHA_URL=
WAHA_SESSION=default
WAHA_CHAT_ID=
WAHA_API_KEY=

# ---- SITE / SYSTEM (defaults match the Faisalabad install) ----
POLL_MINUTES=10
TZ_NAME=Asia/Karachi
LAT=31.42
LON=73.08
KWP_W=8400
PV_CAP_W=6500
SYSTEM_LOSS=0.86
BATT_WH=5120
RESERVE_SOC=50

# ---- THRESHOLDS ----
PV2_DEAD_VOLTS=50
PR_ALERT=0.65
EVENING_SOC_LOCK=55
DEEP_SOC=15
STALE_MINUTES=30
ALERT_COOLDOWN_MIN=90
DIGEST_HOUR=21
FORECAST_HOUR=18

# ---- DASHBOARD ----
HTTP_PORT=8080

# ---- MONEY / METERS ----
TARIFF_RS=45
# Total install cost in Rs — enables the payback card (e.g. 1500000)
SYSTEM_COST_RS=
# Units generated before tracking began (offsets payback)
PAYBACK_BASE_KWH=0
NM_EXPORT_RS=27
# healthchecks.io ping URL — alerts you if the watchdog itself dies
HEARTBEAT_URL=

# ---- DESSMONITOR LOGIN (auto-refreshing tokens — replaces copied-URL fragility) ----
# Your dessmonitor.com / SmartESS login. DESS_URL is still needed (device params).
DESS_USER=
DESS_PASSWORD=

# ---- DASHBOARD PASSWORD (required before public deploy) ----
DASH_PASSWORD=

# Public dashboard URL — appended to alerts, used in PWA manifest
PUBLIC_URL=https://solar.skillmatch.tech
