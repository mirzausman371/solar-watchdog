# ---- REQUIRED ----
# Long-lived signed querySPDeviceLastData URL.
# Get it: dessmonitor.com → login (SmartESS creds) → DevTools → Network →
# filter "querySPDeviceLastData" → right-click request → Copy URL.
DESS_URL=

# ---- ALERT CHANNELS (set at least one) ----
# Telegram: create bot via @BotFather, get chat id via @userinfobot
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
# WAHA (self-hosted WhatsApp): chat id looks like 923001234567@c.us
WAHA_URL=
WAHA_SESSION=default
WAHA_CHAT_ID=
WAHA_API_KEY=

# ---- SITE / SYSTEM (defaults match the Faisalabad install) ----
POLL_MINUTES=10
TZ_NAME=Asia/Karachi
LAT=31.42
LON=73.08
KWP_W=8400
PV_CAP_W=6500
SYSTEM_LOSS=0.86
BATT_WH=5120
RESERVE_SOC=50

# ---- THRESHOLDS ----
PV2_DEAD_VOLTS=50
PR_ALERT=0.65
EVENING_SOC_LOCK=55
DEEP_SOC=15
STALE_MINUTES=30
ALERT_COOLDOWN_MIN=90
DIGEST_HOUR=21
FORECAST_HOUR=18

# ---- DASHBOARD ----
HTTP_PORT=8080

# ---- MONEY / METERS ----
TARIFF_RS=45
# Total install cost in Rs — enables the payback card (e.g. 1500000)
SYSTEM_COST_RS=
# Units generated before tracking began (offsets payback)
PAYBACK_BASE_KWH=0
NM_EXPORT_RS=27
# healthchecks.io ping URL — alerts you if the watchdog itself dies
HEARTBEAT_URL=

# ---- DESSMONITOR LOGIN (auto-refreshing tokens — replaces copied-URL fragility) ----
# Your dessmonitor.com / SmartESS login. DESS_URL is still needed (device params).
DESS_USER=
DESS_PASSWORD=

# ---- DASHBOARD PASSWORD (required before public deploy) ----
DASH_PASSWORD=

# Public dashboard URL — appended to alerts, used in PWA manifest
PUBLIC_URL=https://solar.skillmatch.tech

# ---- TUYA CLOUD (TOMZN whole-house energy breaker) ----
# From iot.tuya.com → your Cloud project → Authorization Key
TUYA_ACCESS_ID=
TUYA_ACCESS_SECRET=
# Device ID of the TOMZN breaker (Cloud → Devices, or Smart Life app → device → info)
TUYA_DEVICE_ID=
# Data center your Smart Life account is in: us | eu | cn | in
TUYA_REGION=eu
# grid = breaker measures WAPDA import (recommended) | house = total consumption
TUYA_ROLE=grid
# Enable WRITE control of the breaker (supply on/off, top-up) — can cut the house. 1=on
TUYA_CONTROL=0

# ---- GRID ALERT + WATER PUMP DETECTION ----
# Alert when breaker (grid) power exceeds this many watts
GRID_HIGH_W=1800
# Water pump (Faisal 2.5HP): rated watts, on/off step, run band, over-run guard
PUMP_W=2000
PUMP_STEP_W=1500
PUMP_ON_W=1600
PUMP_MAX_RUN_MIN=45
# Fast breaker poll (min) for grid/pump detection
PUMP_POLL_MIN=3

# ---- FESCO AUTO-FETCH ----
# Auto-pull each meter latest bill from bill.pitc.com.pk monthly (1=on default). 0=off
FESCO_AUTOFETCH=1
# Shared secret for the PK-IP fetcher to push readings (see fesco-push.mjs)
FESCO_PUSH_TOKEN=
